{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "sultan-agent",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "observability": { "enabled": true },
  // Regenerates the knowledge from the site's data before every `wrangler dev` / `wrangler deploy`.
  // Run wrangler from the repository root (the npm scripts do: npm run agent:dev / agent:deploy).
  "build": { "command": "npm run knowledge", "watch_dir": ["src", "../data", "../lib/agent", "../lib/cv"] },
  "vars": {
    "ENVIRONMENT": "production",
    "ALLOWED_ORIGINS": "https://sultalfaifi.com,https://www.sultalfaifi.com",
    "SITE_URL": "https://sultalfaifi.com",
    // Any OpenRouter model slug works; check the exact one at openrouter.ai/models.
    "MODEL": "anthropic/claude-sonnet-5.5",
    "REASONING_EFFORT": "low",
    // A domain you verified in Resend. The recipient is never configurable: it's Sultan's address from the site data.
    "EMAIL_FROM": "Sultan Alfaifi <hello@sultalfaifi.com>",
    "EMAIL_NOTIFY_FROM": "notifications@sultalfaifi.com",
    "DAILY_CHAT_CAP": "400",
    "DAILY_CHAT_PER_VISITOR": "40",
    "DAILY_EMAIL_CAP": "25",
    "DAILY_EMAIL_PER_VISITOR": "3",
    "DAILY_CODE_CAP": "40",
    "DAILY_TAILOR_CAP": "80",
    "DAILY_TAILOR_PER_VISITOR": "8"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sultan-agent",
      // Created with `npx wrangler d1 create sultan-agent` (region EEUR).
      "database_id": "750fd858-c45e-4ee2-8752-4bd86b2611e9",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    { "name": "CHAT_LIMITER", "namespace_id": "4101", "simple": { "limit": 8, "period": 60 } },
    { "name": "ACTION_LIMITER", "namespace_id": "4102", "simple": { "limit": 4, "period": 60 } }
  ],
  "triggers": { "crons": ["17 3 * * *"] },
  "env": {
    // `wrangler dev --env dev` (npm run agent:dev): local origins, local D1, Turnstile test keys from .dev.vars.
    "dev": {
      "vars": {
        "ENVIRONMENT": "development",
        "ALLOWED_ORIGINS": "http://localhost:3000,http://localhost:3123,http://127.0.0.1:3000,http://127.0.0.1:3123",
        "SITE_URL": "http://localhost:3000",
        "MODEL": "anthropic/claude-sonnet-5.5",
        "REASONING_EFFORT": "low",
        "EMAIL_FROM": "Sultan Alfaifi <hello@sultalfaifi.com>",
        "EMAIL_NOTIFY_FROM": "notifications@sultalfaifi.com",
        "DAILY_CHAT_CAP": "400",
        "DAILY_CHAT_PER_VISITOR": "200",
        "DAILY_EMAIL_CAP": "25",
        "DAILY_EMAIL_PER_VISITOR": "10",
        "DAILY_CODE_CAP": "40",
        "DAILY_TAILOR_CAP": "80",
        "DAILY_TAILOR_PER_VISITOR": "40"
      },
      "d1_databases": [
        { "binding": "DB", "database_name": "sultan-agent-dev", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
      ],
      "ratelimits": [
        { "name": "CHAT_LIMITER", "namespace_id": "4201", "simple": { "limit": 60, "period": 60 } },
        { "name": "ACTION_LIMITER", "namespace_id": "4202", "simple": { "limit": 30, "period": 60 } }
      ]
    }
  }
}
