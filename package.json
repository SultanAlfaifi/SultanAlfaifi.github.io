    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "axe-core": "^4.11.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.2.12",
    "jsdom": "^26.1.0",
    "serve": "14.2.6",
    "sharp": "0.35.3",
    "tailwindcss": "4.3.3",
    "tsx": "^4.21.0",
    "typescript": "6.0.3"
  },
